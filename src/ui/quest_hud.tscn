[gd_scene load_steps=3 format=3 uid="uid://quest_hud_123"]

[sub_resource type="GDScript" id="GDScript_quest_hud"]
script/source = "extends CanvasLayer

@onready var label = $Control/PanelContainer/QuestLabel
@onready var panel = $Control/PanelContainer

func _ready():
	panel.hide()
	var q_manager = get_node_or_null(\"/root/QuestSystem\")
	if q_manager:
		q_manager.quest_updated.connect(_on_quest_updated)
		q_manager.quest_completed.connect(_on_quest_completed)
		
		# Neu game dang co quest san khi load scene
		if q_manager.is_quest_active:
			_on_quest_updated(q_manager.get_display_text())

func _on_quest_updated(text: String):
	label.text = text
	panel.show()
	
	# Hieu ung xuat hien nhe nhang
	panel.modulate.a = 0
	var tween = create_tween()
	tween.tween_property(panel, \"modulate:a\", 1.0, 0.5)

func _on_quest_completed():
	var tween = create_tween()
	tween.tween_property(panel, \"modulate:a\", 0, 0.5)
	await tween.finished
	panel.hide()
"

